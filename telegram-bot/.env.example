# PayProof Telegram bot environment (local development)
#
# Copy this file to `.env` and fill in real values.
# Never commit real credentials.

# Required — Telegram Bot API token from @BotFather.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Required — Supabase project URL. Must match the website's project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Required — Supabase service-role key. Server-side only; never expose it to a
# browser, Telegram, or logs.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional — overrides the Solana RPC endpoint used by /balance.
# Defaults to the public Devnet endpoint when unset or invalid.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com