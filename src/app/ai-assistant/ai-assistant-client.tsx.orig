"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import DashboardShell from "@/components/dashboard/dashboard-shell";
import { AssistantIcon, SendPlaneIcon, TrashIcon } from "@/components/dashboard/icons";
import { AssistantBubble, UserBubble } from "@/components/ai-chat/message-bubble";

interface Message {
  id: string;
  role: "user" | "assistant";
  text: string;
  timestamp: Date;
}

type ChatState =
  | { status: "empty" }
  | { status: "ready"; messages: readonly Message[] }
  | { status: "loading"; lastText: string; messages: readonly Message[] };

const FEATURED_PROMPTS = [
  {
    icon: (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className="size-4 text-[#9945FF]">
        <path d="M14 3.5H7a1.8 1.8 0 0 0-1.8 1.8v13.4A1.8 1.8 0 0 0 7 20.5h10a1.8 1.8 0 0 0 1.8-1.8V8.3Z" />
        <path d="M14 3.5v4.8h4.8" />
